{
  "name": "opencode-plusplus",
  "version": "0.2.4",
  "description": "The official OpenCode Desktop Windows plugin with an in-plugin reliability harness. Install from the release EXE and use inside OpenCode Desktop.",
  "type": "module",
  "bin": {
    "opencode-plusplus": "./dist/cli/index.js",
    "opencode-plusplus-mcp": "./dist/mcp/server.js"
  },
  "files": [
    ".env.example",
    "dist/**/*.js",
    "README.md",
    "README.en.md",
    "README.zh-CN.md",
    "opencode-plusplus.config.example.yml",
    "opencode-plusplus.local.example.yml"
  ],
  "scripts": {
    "package-info:generate": "node scripts/generate-package-info.mjs",
    "package-info:check": "node scripts/generate-package-info.mjs --check",
    "clean:build": "node scripts/clean-build.mjs",
    "prebuild:core": "npm run package-info:generate",
    "build": "npm run build:core",
    "build:core": "tsc -p tsconfig.json && node scripts/ensure-bin-executable.mjs",
    "build:installer:windows": "node scripts/build-windows-installer.mjs",
    "pretest:installer:windows": "npm run build:installer:windows",
    "test:installer:windows": "node scripts/smoke-windows-installer.mjs",
    "test:desktop:real": "node scripts/smoke-windows-installer.mjs --require-real-desktop-launch",
    "predev": "npm run package-info:generate",
    "dev": "tsx src/cli/index.ts",
    "premcp": "npm run package-info:generate",
    "mcp": "tsx src/mcp/server.ts",
    "check": "npm run check:core",
    "precheck:core": "npm run package-info:generate",
    "check:core": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "npm run lint:core",
    "lint:core": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.{ts,mjs}\"",
    "format": "prettier --ignore-unknown --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"README*.md\" \"docs/**/*.md\" \"*.{json,yml,yaml,cjs,js}\" \".github/**/*.yml\" \".env.example\" \"benchmarks/README.md\" \"benchmarks/expected/*.json\" \"benchmarks/tasks/*.json\" \"benchmarks/agent-runs/*.json\" \"benchmarks/fixtures/**/*.json\"",
    "format:check": "prettier --ignore-unknown --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"README*.md\" \"docs/**/*.md\" \"*.{json,yml,yaml,cjs,js}\" \".github/**/*.yml\" \".env.example\" \"benchmarks/README.md\" \"benchmarks/expected/*.json\" \"benchmarks/tasks/*.json\" \"benchmarks/agent-runs/*.json\" \"benchmarks/fixtures/**/*.json\"",
    "docs:cli": "tsx scripts/generate-cli-docs.ts",
    "docs:cli:check": "tsx scripts/generate-cli-docs.ts --check",
    "docs:bilingual:check": "node scripts/check-docs-bilingual.mjs",
    "test": "npm run test:core",
    "pretest:core": "npm run package-info:generate",
    "test:core": "node scripts/run-tests.mjs",
    "test:windows": "tsx --test test/safe-command.test.ts test/task-args.test.ts test/opencode-plugin-runtime.test.ts test/plugin-harness-args.test.ts test/plugin-harness-format.test.ts test/plugin-harness-session.test.ts test/plugin-harness-findings.test.ts test/plugin-harness-tools.test.ts test/plugin-bundle.test.ts test/release-boundary.test.ts test/windows-installer.test.ts",
    "benchmark": "tsx src/cli/index.ts benchmark benchmarks --top-k 8",
    "benchmark:desktop": "tsx scripts/run-desktop-plugin-benchmark.ts",
    "benchmark:explainability": "tsx scripts/run-context-explainability-benchmark.ts",
    "benchmark:agent": "tsx src/cli/index.ts benchmark-agent benchmarks --executor mock --dry-run",
    "benchmark:deterministic": "npm run benchmark && npm run benchmark:agent && npm run benchmark:explainability",
    "benchmark:agent:real": "tsx src/cli/index.ts benchmark-agent-real benchmarks",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts",
    "pack:json": "npm pack --json --dry-run --ignore-scripts",
    "release:verify": "node scripts/verify-release.mjs",
    "prepublishOnly": "npm run clean:build && npm run check && npm run lint && npm run format:check && npm run docs:cli:check && npm run docs:bilingual:check && npm test && npm run benchmark:deterministic && npm run build && npm run release:verify"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/whut09/opencode-plusplus.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-ai",
    "opencode-desktop",
    "opencode-plusplus",
    "opencode-harness",
    "coding-agent",
    "agent-harness",
    "verification",
    "regression-guard",
    "hallucination-guard"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "commander": "^14.0.2",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.5",
    "js-tiktoken": "^1.0.21",
    "js-yaml": "^4.1.0",
    "typescript": "^5.9.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.9.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "prettier": "^3.8.4",
    "tsx": "^4.20.6",
    "typescript-eslint": "^8.61.0"
  }
}
